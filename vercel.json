{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "node --version",
  "functions": {
    "api/health.js": {
      "maxDuration": 10
    },
    "api/http.js": {
      "maxDuration": 60
    },
    "api/aio.js": {
      "maxDuration": 60
    },
    "api/download.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/public/index.html"
    },
    {
      "source": "/index.html",
      "destination": "/public/index.html"
    },
    {
      "source": "/manifest.webmanifest",
      "destination": "/public/manifest.webmanifest"
    },
    {
      "source": "/service-worker.js",
      "destination": "/public/service-worker.js"
    },
    {
      "source": "/scrapers-version.json",
      "destination": "/public/scrapers-version.json"
    },
    {
      "source": "/share.html",
      "destination": "/public/share.html"
    },
    {
      "source": "/assets/:path*",
      "destination": "/public/assets/:path*"
    },
    {
      "source": "/css/:path*",
      "destination": "/public/css/:path*"
    },
    {
      "source": "/js/:path*",
      "destination": "/public/js/:path*"
    }
  ],
  "headers": [
    {
      "source": "/service-worker.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json; charset=utf-8"
        }
      ]
    }
  ]
}
